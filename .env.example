# ============================================================
# OPERAN — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables are server-only and must NOT be prefixed.
#
# After changing environment variables, redeploy the application
# (Vercel requires a new deployment for env var changes to take effect).
# ============================================================

# ------------------------------------------------------------
# Public browser-safe variables
# ------------------------------------------------------------
# The canonical application URL (no trailing slash).
# Used for OAuth redirects, webhook endpoint URLs, and iCal feed base URL.
# In staging: your Vercel deployment URL
# In production: https://app.operan.io
NEXT_PUBLIC_APP_URL=

# Supabase — public anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — publishable key (safe for browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# Server-only database variables
# ------------------------------------------------------------
# Supabase service role key — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ------------------------------------------------------------
# Stripe — platform payment infrastructure
# ------------------------------------------------------------
# Platform secret key (sk_test_... or sk_live_...)
# Used for Stripe Connect: creates tenant Express accounts,
# checkout sessions, refunds, and webhook verification.
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard (whsec_...)
# Required for verifying incoming Stripe webhook events.
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Resend — email delivery platform infrastructure
# ------------------------------------------------------------
# Platform API key from Resend Dashboard (re_...)
# Used for domain management, email sending, and webhook verification.
RESEND_API_KEY=
# Webhook signing secret from Resend Dashboard
# Required for verifying incoming email delivery events.
RESEND_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Google Calendar — OAuth client configuration
# ------------------------------------------------------------
# OAuth 2.0 client ID from Google Cloud Console
# Required for tenants to connect their Google Calendar.
GOOGLE_CLIENT_ID=
# OAuth 2.0 client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=
# OAuth redirect URI (must match Google Cloud Console exactly)
# Typically: https://your-domain.com/api/integrations/google-calendar/callback
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------
# Twilio — SMS and WhatsApp (future)
# ------------------------------------------------------------
# Twilio Account SID
TWILIO_ACCOUNT_SID=
# Twilio Auth Token
TWILIO_AUTH_TOKEN=
# Default Twilio messaging service SID
TWILIO_MESSAGING_SERVICE_SID=

# ------------------------------------------------------------
# WhatsApp — Meta Cloud API (future)
# ------------------------------------------------------------
# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WhatsApp access token
WHATSAPP_ACCESS_TOKEN=
# WhatsApp phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp webhook verify token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------
# QuickBooks — OAuth client configuration (future)
# ------------------------------------------------------------
# QuickBooks OAuth client ID
QUICKBOOKS_CLIENT_ID=
# QuickBooks OAuth client secret
QUICKBOOKS_CLIENT_SECRET=
# QuickBooks OAuth redirect URI
QUICKBOOKS_REDIRECT_URI=

# ------------------------------------------------------------
# Integration encryption
# ------------------------------------------------------------
# Used to encrypt OAuth tokens and provider credentials stored
# in the database. Must be a 32+ character random string.
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Cron and internal workers
# ------------------------------------------------------------
# Secret used to authenticate cron job invocations
CRON_SECRET=

# ------------------------------------------------------------
# Legacy — GoHighLevel (deprecated, no longer used)
# ------------------------------------------------------------
GHL_PROXY_URL=
GHL_PROXY_ANON_KEY=
GHL_PIPELINE_ID=
GHL_PIPELINE_NAME=
