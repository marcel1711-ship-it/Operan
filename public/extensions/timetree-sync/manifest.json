{
  "manifest_version": 3,
  "name": "OPERAN TimeTree Sync",
  "version": "1.0.0",
  "description": "Automatically syncs TimeTree calendar events to OPERAN",
  "permissions": ["alarms"],
  "host_permissions": [
    "https://timetreeapp.com/*",
    "https://zxflexiywouechzvapbi.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://timetreeapp.com/calendars/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  }
}
